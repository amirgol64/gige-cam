[Unit]
Description=GigE-Cam camera manager (GStreamer + ZMQ)
After=network.target
Wants=network.target

[Service]
Type=simple
ExecStart=/opt/camstreamer/venv/bin/python3 /opt/camstreamer/app/camera_mgr.py
WorkingDirectory=/opt/camstreamer/app
Restart=always
RestartSec=5
TimeoutStopSec=10
StartLimitInterval=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camstreamer-cam

[Install]
WantedBy=multi-user.target
